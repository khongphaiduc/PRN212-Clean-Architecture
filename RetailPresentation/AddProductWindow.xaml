<Window x:Class="RetailPresentation.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm sản phẩm mới" Height="460" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="24">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,22">
                    <TextBlock Text="Thêm sản phẩm" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Điền thông tin sản phẩm và tồn kho ban đầu"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Tên sản phẩm" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <TextBox x:Name="txtName" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="Danh mục" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                        <ComboBox x:Name="cboCategory" DisplayMemberPath="Name" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Giá bán" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                            <TextBox x:Name="txtPrice" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số lượng đầu" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                            <TextBox x:Name="txtQuantity" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnCancel"
                            Content="Hủy"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Click="btnCancel_Click" />
                    <Button x:Name="btnSave"
                            Content="Lưu sản phẩm"
                            Style="{StaticResource ModernButton}"
                            Click="btnSave_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
