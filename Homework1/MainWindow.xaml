<Window x:Class="Homework1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản lý dự án và nhân viên" Height="650" Width="1120"
        MinHeight="580" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Margin="0,0,0,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Quản lý dự án và nhân viên" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Chọn dự án, theo dõi thành viên và phân công vai trò"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="14"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Danh sách dự án"
                               Style="{StaticResource SectionTitleText}"
                               Margin="0,0,0,14" />

                    <DataGrid x:Name="dgProjects"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionChanged="dgProjects_SelectionChanged"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên dự án" Binding="{Binding ProjectName}" Width="2*" />
                            <DataGridTextColumn Header="Ngày bắt đầu" Binding="{Binding StartDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="1.2*" />
                            <DataGridTextColumn Header="Ngày kết thúc" Binding="{Binding EndDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Thêm nhân viên vào dự án"
                                   Style="{StaticResource SectionTitleText}"
                                   Margin="0,0,0,14" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Nhân viên" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                <ComboBox x:Name="cbEmployees"
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="EmployeeId" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vai trò" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                <TextBox x:Name="txtRole" />
                            </StackPanel>

                            <Button x:Name="btnAddEmployee"
                                    Grid.Column="4"
                                    Content="Thêm vào dự án"
                                    Style="{StaticResource SuccessButton}"
                                    VerticalAlignment="Bottom"
                                    Click="btnAddEmployee_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Nhân viên đang tham gia"
                                   Style="{StaticResource SectionTitleText}"
                                   Margin="0,0,0,14" />

                        <DataGrid x:Name="dgProjectEmployees"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Họ và tên" Binding="{Binding EmployeeName}" Width="1.5*" />
                                <DataGridTextColumn Header="Email" Binding="{Binding EmployeeEmail}" Width="1.8*" />
                                <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleInProject}" Width="1.1*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
