<Window x:Class="Homework1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Homework1"
        mc:Ignorable="d"
        Title="Quản Lý Dự Án &amp; Nhân Viên" Height="550" Width="950" Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="Danh sách dự án" Grid.Column="0" Margin="5" Padding="5">
            <DataGrid x:Name="dgProjects" AutoGenerateColumns="False" IsReadOnly="True" 
                      SelectionChanged="dgProjects_SelectionChanged" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên Dự Án" Binding="{Binding ProjectName}" Width="2*" />
                    <DataGridTextColumn Header="Ngày Bắt Đầu" Binding="{Binding StartDate, StringFormat=\{0:dd/MM/yyyy\}}" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="Thêm nhân viên vào dự án này" Grid.Row="0" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Chọn nhân viên:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,5"/>
                    <ComboBox x:Name="cbEmployees" Grid.Row="0" Grid.Column="1" Margin="15,5,5,5" DisplayMemberPath="FullName" SelectedValuePath="EmployeeId"/>

                    <TextBlock Text="Vai trò:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,5"/>
                    <TextBox x:Name="txtRole" Grid.Row="1" Grid.Column="1" Margin="15,5,5,5" VerticalAlignment="Center"/>

                    <Button x:Name="btnAddEmployee" Content="Thêm vào dự án" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" 
                            Width="120" Margin="5,5,0,5" Click="btnAddEmployee_Click" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Danh sách nhân viên đang tham gia dự án" Grid.Row="1" Padding="5">
                <DataGrid x:Name="dgProjectEmployees" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding EmployeeName}" Width="2*" />
                        <DataGridTextColumn Header="Email" Binding="{Binding EmployeeEmail}" Width="2*" />
                        <DataGridTextColumn Header="Vai Trò" Binding="{Binding RoleInProject}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>